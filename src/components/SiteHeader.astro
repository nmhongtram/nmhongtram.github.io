---
import { labels } from "../data/ui";

interface Props {
  locale: "en" | "vi";
  role: "research" | "engineer";
  cv: string;
}

const { locale, role, cv } = Astro.props;
const t = labels[locale];
const researchHref = locale === "vi" ? "/vi/" : "/";
const engineerHref = locale === "vi" ? "/vi/engineer/" : "/engineer/";
const languageEnHref = role === "engineer" ? "/engineer/" : "/";
const languageViHref = role === "engineer" ? "/vi/engineer/" : "/vi/";
const nav =
  role === "research"
    ? [
        { href: "#journey", label: t.journeyNav },
        { href: "#research", label: t.researchNav },
        { href: "#publications", label: t.publicationsNav },
        { href: "#experience", label: t.experienceNav },
        { href: "#projects", label: t.projectsNav },
        { href: "#about", label: t.aboutNav },
      ]
    : [
        { href: "#builds", label: t.buildsNav },
        { href: "#experience", label: t.experienceNav },
        { href: "#capabilities", label: t.capabilitiesNav },
        { href: "#recognition", label: t.recognitionNav },
        { href: "#contact", label: t.contactNav },
      ];
---

<header class="site-header">
  <a class="brand" href="#top" aria-label={`${t.backToTop}: ${t.siteName}`}>
    NMHT<span class="brand-mark">/</span>
  </a>
  <nav class="role-switch" aria-label={t.portfolioViews}>
    <a
      href={researchHref}
      aria-current={role === "research" ? "page" : undefined}
    >
      {t.researchView}
    </a>
    <a
      href={engineerHref}
      aria-current={role === "engineer" ? "page" : undefined}
    >
      {t.engineerView}
    </a>
  </nav>
  <nav class="desktop-nav" aria-label={t.primaryNavigation}>
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  <div class="header-controls">
    <div class="language-switch" role="group" aria-label={t.language}>
      <a
        href={languageEnHref}
        lang="en"
        aria-current={locale === "en" ? "page" : undefined}
      >
        EN
      </a>
      <span aria-hidden="true">|</span>
      <a
        href={languageViHref}
        lang="vi"
        aria-current={locale === "vi" ? "page" : undefined}
      >
        VI
      </a>
    </div>
    <button
      class="theme-toggle"
      type="button"
      aria-label={t.darkMode}
      title={t.darkMode}
      data-label-dark={t.darkMode}
      data-label-light={t.lightMode}
    >
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.3 15.7A8.6 8.6 0 0 1 8.3 3.7 8.7 8.7 0 1 0 20.3 15.7Z" />
      </svg>
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
    </button>
    <a class="header-cv" href={cv} target="_blank" rel="noopener">
      {t.readCv} <span aria-hidden="true">↗</span>
    </a>
  </div>
  <details class="mobile-menu">
    <summary>{t.menu}</summary>
    <nav aria-label={t.mobileNavigation}>
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={cv} target="_blank" rel="noopener">
        {t.readCv} ↗
      </a>
    </nav>
  </details>
</header>

<script>
  const themeToggle =
    document.querySelector<HTMLButtonElement>(".theme-toggle");
  const updateThemeButton = () => {
    if (!themeToggle) return;
    const isDark = document.documentElement.dataset.theme === "dark";
    const label = isDark
      ? themeToggle.dataset.labelLight
      : themeToggle.dataset.labelDark;
    themeToggle.setAttribute("aria-label", label ?? "");
    themeToggle.title = label ?? "";
    themeToggle.setAttribute("aria-pressed", String(isDark));
  };
  updateThemeButton();
  themeToggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("portfolio-theme", next);
    } catch {}
    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute("content", next === "dark" ? "#111c1c" : "#f1f5f0");
    updateThemeButton();
  });

  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.open = false;
    }),
  );
</script>
