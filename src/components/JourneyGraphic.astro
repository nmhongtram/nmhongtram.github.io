---
import { labels } from "../data/ui";

type Stage = { diagram: readonly string[] };
interface Props {
  stage: Stage;
  locale?: "en" | "vi";
}
const { stage, locale = "en" } = Astro.props;
const t = labels[locale];
---

<div
  class="concept-graphic"
  role="img"
  aria-label={`${t.diagramLabel}: ${stage.diagram.join(t.diagramConnector)}`}
>
  <div class="concept-steps" aria-hidden="true">
    {stage.diagram.map((node, index) => (
      <div class="concept-step">
        <span class="concept-index">{String(index + 1).padStart(2, "0")}</span>
        <strong>{node}</strong>
      </div>
    ))}
  </div>
  <p class="concept-caption">{t.diagramCaption}</p>
</div>
